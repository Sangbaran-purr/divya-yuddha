{
  "about": "EXPORT-1/2 \u2014 the premium presentation routing table. `routes`: the Astras that play an additive effect clip on the game's own beats (EXPORT-1; Brahmastra's rebuilt clip joins in EXPORT-3). `actors`: the Heroes whose play manifests as an actor (EXPORT-2) \u2014 AWAKEN, EMERGE, ACT, SETTLE, native exits, in place, at the rung their drawn size needs (EXPORT-4: 512 above 420 device px, else 256), Full in every mode. Remove a card's entry and it returns to its classic presentation by a data edit, no revert. A clip or actor that is not ready, or fails, at its moment falls back to the classic path (owner ruling EXPORT-1/7: yesterday's game, never absence).",
  "version": 2,
  "routes": {
    "vajra": {
      "spec": "effects/vajra/manifest.json",
      "replaces": "sprVajra",
      "moment": "destroy",
      "anchor": "target-card-centre"
    },
    "sudarshana": {
      "spec": "effects/sudarshana/chain.json",
      "replaces": "sprSudarshana",
      "moment": "passive",
      "anchor": "caster-half-centre, then the removed hero"
    },
    "pashupata": {
      "spec": "effects/pashupata/manifest.json",
      "replaces": "sprPashupatastra",
      "moment": "play",
      "anchor": "enemy-half-top (fitted: 1.047 of the half's width, never taller than the half)"
    },
    "brahmastra": {
      "spec": "effects/brahmastra/manifest.json",
      "replaces": "sprBrahmastra",
      "moment": "play",
      "anchor": "enemy-half-top (fitted: 0.93 of the half's width, never taller than the half)"
    },
    "venomstrike": {
      "spec": "effects/venomstrike_rise/manifest.json",
      "replaces": "sprVenomSurge",
      "moment": "play",
      "anchor": "caster-half-bottom (height-fit: 1.0 of the half's HEIGHT, bottom-flush); an arming clip, started when decoded, never partial",
      "drain": {
        "spec": "effects/venomstrike_flood/manifest.json",
        "replaces": "sprVenomDrain",
        "moment": "drain",
        "anchor": "enemy-half-bottom (height-fit, bottom-flush); the empowered round-end Venom drain, its eruption on the drain's first venom beat"
      }
    }
  },
  "pinned": {
    "meghnad": "the lab's pilot and reference, never exported; his live presentation (the Unit landing path) stays exactly as it is"
  },
